# ============================================================
#  انسخ هذا الملف باسم secrets.toml وضع فيه بيانات حساب الخدمة
#  (Service Account) من Google Cloud.
#  على Streamlit Cloud: Settings <- Secrets <- الصق نفس المحتوى.
# ============================================================

[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
client_email = "fleet-bot@your-project-id.iam.gserviceaccount.com"
client_id = "1234567890"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/fleet-bot%40your-project-id.iam.gserviceaccount.com"

[gsheets]
spreadsheet_title = "بيانات أسطول صندوق النظافة - المهرة"
spreadsheet_id = ""
share_with = ["your-email@gmail.com"]
